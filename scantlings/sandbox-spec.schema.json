{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/gh/dmytri/tinman@main/scantlings/sandbox-spec.schema.json",
  "title": "Tinman backend-neutral sandbox specification",
  "description": "The portable, backend-neutral shape every sandbox backend reads. Referenced by features/sandbox-specification.feature. No Bubblewrap mechanics appear here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["backend", "home", "network"],
  "properties": {
    "backend": {
      "description": "Which backend prepares the process.",
      "enum": ["auto", "bubblewrap", "mac", "none"]
    },
    "home": {
      "description": "How the sandbox home directory is provisioned.",
      "enum": ["empty", "fixture"]
    },
    "network": {
      "description": "Whether the sandboxed process may reach the network.",
      "enum": ["allow", "deny"]
    },
    "path": {
      "description": "Controlled PATH entries visible inside the sandbox.",
      "type": "array",
      "items": { "type": "string" }
    },
    "env": {
      "description": "Environment variables injected into the sandbox.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["from"],
            "properties": { "from": { "enum": ["fixture", "host"] } }
          }
        ]
      }
    },
    "mounts": {
      "description": "Explicitly mounted fixture trees.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "mode"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "mode": { "enum": ["readonly", "copy", "writable"] }
        }
      }
    }
  }
}
